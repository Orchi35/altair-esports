# Partnership enquiry API (server only)
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
PARTNERSHIP_RECIPIENT_EMAIL=
# Set true only when production release requires the mail conversion path.
PARTNERSHIP_MAIL_REQUIRED=false

# Optional: path to a local Chromium/Edge executable for media kit PDF builds.
MEDIA_KIT_BROWSER_PATH=

# Optional client-side analytics debug output. Keep false in production.
VITE_ANALYTICS_DEBUG=false
