{
  "functions": {
    "api/vpg-cup.js": {"maxDuration":10},
    "api/vpg-player.js": {"maxDuration":20},
    "api/vpg-match.js": {
      "maxDuration": 10
    },
    "api/vpg-roster.js": {
      "maxDuration": 10
    },
    "api/vpg.js": {
      "includeFiles": "public/data/vpg-elite-b.json",
      "maxDuration": 10
    },
    "api/match-center.js": {
      "includeFiles": "public/data/**/*.json",
      "maxDuration": 10
    },
    "api/partnership-inquiry.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {"source":"/b/:id([A-Za-z0-9_-]{12})","destination":"/tr/builder/index.html"},
    {"source":"/tr/oyuncular/vpg-:id(\\d+)","destination":"/tr/index.html"},
    {"source":"/en/players/vpg-:id(\\d+)","destination":"/en/index.html"},
    {"source":"/tr/maclar/match-vpg-:id(\\d+)","destination":"/tr/index.html"},
    {"source":"/en/matches/match-vpg-:id(\\d+)","destination":"/en/index.html"}
  ],
  "headers": [
    {"source":"/b/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"},{"key":"X-Robots-Tag","value":"noindex, follow"}]},
    {"source":"/","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/tr/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/en/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/app-recovery.js","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/sw-policy.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: https:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}

